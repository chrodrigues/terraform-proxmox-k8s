---
# Generated by Terraform - do not edit by hand.
all:
  vars:
    ansible_user: ${vm_user}
    ansible_ssh_private_key_file: ${ssh_private_key}
  children:
    dns:
      hosts:
        bind9-dns-server:
          ansible_host: ${dns_ip}
    k8s:
      children:
        control_plane:
          hosts:
%{ for name, ip in control_plane_nodes ~}
            ${name}:
              ansible_host: ${ip}
%{ endfor ~}
        workers:
          hosts:
%{ for name, ip in worker_nodes ~}
            ${name}:
              ansible_host: ${ip}
%{ endfor ~}
