$TTL 86400
@   IN  SOA  ns1.{{ domain }}. admin.{{ domain }}. (
          1          ; Serial
          3600       ; Refresh
          1800       ; Retry
          604800     ; Expire
          86400      ; Minimum TTL
)
@       IN  NS   ns1.{{ domain }}.
ns1     IN  A    {{ dns_server_ip }}
dns     IN  A    {{ dns_server_ip }}
{% for host in groups['all'] %}
{{ host }} IN A {{ hostvars[host].ansible_host }}
{% endfor %}
{% for record in bind9_extra_records | default([]) %}
{{ record.name }} IN A {{ record.ip }}
{% endfor %}
